{
  "name": "fetch-multipart",
  "version": "0.0.0",
  "description": "Standards-inspired multipart/* parsing. Like response.text() but for multipart bodies.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=26"
  },
  "exports": {
    ".": {
      "types": "./dist/mod.d.ts",
      "default": "./dist/mod.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test",
    "bench": "node ./bench/runner.ts",
    "bench:profile": "node --cpu-prof --heap-prof ./bench/runner.ts",
    "bench:steady": "node --expose-gc ./bench/runner.ts --steady --metrics",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@fastify/busboy": "^3.2.2",
    "@remix-run/multipart-parser": "^0.16.4",
    "@types/busboy": "^1.5.4",
    "@types/node": "^26.5.1",
    "busboy": "^1.6.0",
    "multipasta": "^0.2.8",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "yaml": "^2.9.0"
  }
}
